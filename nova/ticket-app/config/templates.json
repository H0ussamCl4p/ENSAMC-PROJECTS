  },
  "email": {
    "subject": "🎟️ Your Ticket for {event_name} / Votre billet pour {event_name}",
    "body": "Hello / Bonjour {name},\n\nYour ticket for {event_name} on {event_date} at {event_location} is attached as a PDF.\nVotre billet pour {event_name} le {event_date} au {event_location} est joint en PDF.\n\nPlease bring this QR code to the entrance. Each ticket is valid for a single entry.\nVeuillez présenter ce code QR à l'entrée. Chaque billet est valable pour une seule entrée.\n\nToken (short): {token_short}\n\nIf you have questions, reply to this email.\nSi vous avez des questions, répondez à cet email.\n\nSee you there! / À bientôt !\n— {organizer}",
    "body_html": "<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><style>*{margin:0;padding:0;box-sizing:border-box}body{font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;background:linear-gradient(135deg,#f5f7fa 0%,#c3cfe2 100%);padding:20px}.email-wrapper{max-width:600px;margin:0 auto}.header{background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);color:white;padding:45px 35px;text-align:center;border-radius:20px 20px 0 0;box-shadow:0 10px 30px rgba(102,126,234,0.3);position:relative;overflow:hidden}.header::before{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(circle,rgba(255,255,255,0.1) 0%,transparent 70%);animation:pulse 4s ease-in-out infinite}@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.1)}}.header h1{font-size:36px;margin-bottom:12px;text-shadow:2px 2px 4px rgba(0,0,0,0.2);position:relative;z-index:1}.event-badge{display:inline-block;background:rgba(255,255,255,0.2);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.3);color:white;padding:8px 20px;border-radius:25px;font-size:14px;margin-top:12px;position:relative;z-index:1}.content{background:white;padding:40px 35px;box-shadow:0 0 40px rgba(0,0,0,0.08)}.language-section{margin-bottom:35px;padding-bottom:30px;border-bottom:2px dashed #e2e8f0}.language-section:last-of-type{border-bottom:none;margin-bottom:0;padding-bottom:0}.lang-badge{display:inline-block;background:linear-gradient(135deg,#f093fb 0%,#f5576c 100%);color:white;padding:6px 16px;border-radius:20px;font-size:12px;font-weight:bold;text-transform:uppercase;letter-spacing:1px;margin-bottom:15px;box-shadow:0 4px 10px rgba(240,147,251,0.3)}.greeting{font-size:20px;color:#2d3748;margin-bottom:15px}.greeting strong{color:#667eea;font-weight:600}.description{color:#4a5568;font-size:15px;line-height:1.8;margin-bottom:20px}.info-box{background:linear-gradient(135deg,#a8edea 0%,#fed6e3 100%);border-radius:15px;padding:25px;margin:25px 0;box-shadow:0 8px 20px rgba(168,237,234,0.3)}.info-row{display:flex;align-items:center;margin:12px 0;color:#2d3748}.info-icon{font-size:20px;margin-right:12px;min-width:30px}.info-label{font-weight:600;margin-right:8px;color:#4a5568}.info-value{color:#2d3748;font-weight:500}.token-box{background:linear-gradient(135deg,#ffeaa7 0%,#fdcb6e 100%);border-radius:12px;padding:20px;text-align:center;margin:25px 0;box-shadow:0 6px 15px rgba(253,203,110,0.4)}.token-label{font-size:13px;text-transform:uppercase;letter-spacing:1.5px;color:#c0392b;font-weight:600;margin-bottom:8px}.token-value{font-size:32px;font-weight:900;color:#e67e22;font-family:'Courier New',monospace;letter-spacing:4px;text-shadow:2px 2px 4px rgba(0,0,0,0.1)}.attachment-notice{background:linear-gradient(135deg,#84fab0 0%,#8fd3f4 100%);border-radius:12px;padding:20px;margin:25px 0;text-align:center;box-shadow:0 6px 15px rgba(132,250,176,0.3)}.attachment-icon{font-size:48px;margin-bottom:10px}.attachment-text{color:#1e7e34;font-weight:600;font-size:15px}.important-box{background:linear-gradient(135deg,#ff9a9e 0%,#fecfef 100%);border-left:5px solid #e74c3c;border-radius:10px;padding:20px;margin:25px 0;box-shadow:0 5px 15px rgba(255,154,158,0.3)}.important-title{color:#c0392b;font-weight:700;font-size:16px;margin-bottom:10px}.important-text{color:#922b21;font-size:14px;line-height:1.8}.divider{height:3px;background:linear-gradient(90deg,transparent,#667eea,transparent);margin:30px 0;border-radius:2px}.footer{background:linear-gradient(135deg,#2d3748 0%,#1a202c 100%);padding:35px;text-align:center;color:#e2e8f0;border-radius:0 0 20px 20px;box-shadow:0 -5px 20px rgba(0,0,0,0.1)}.footer-logo{font-size:24px;font-weight:bold;margin-bottom:15px;background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}.footer-text{font-size:13px;opacity:0.8;margin:8px 0;line-height:1.6}.footer-note{font-size:11px;opacity:0.6;margin-top:18px;font-style:italic}.social-icons{margin-top:20px}.social-icon{display:inline-block;width:36px;height:36px;margin:0 6px;background:rgba(255,255,255,0.1);border-radius:50%;line-height:36px;font-size:18px;transition:all 0.3s}.social-icon:hover{background:rgba(255,255,255,0.2);transform:translateY(-2px)}</style></head><body><div class=\"email-wrapper\"><div class=\"header\"><h1>🎟️ {event_name}</h1><div class=\"event-badge\">📅 {event_date} • 📍 {event_location}</div></div><div class=\"content\"><div class=\"language-section\"><span class=\"lang-badge\">🇬🇧 English</span><p class=\"greeting\">Hello <strong>{name}</strong>,</p><p class=\"description\">Your ticket is ready! We're excited to welcome you to our event. Please find your personalized ticket attached to this email as a PDF.</p></div><div class=\"attachment-notice\"><div class=\"attachment-icon\">📎</div><div class=\"attachment-text\">Your ticket is attached as a PDF<br>Votre billet est joint en PDF</div></div><div class=\"language-section\"><span class=\"lang-badge\">🇫🇷 Français</span><p class=\"greeting\">Bonjour <strong>{name}</strong>,</p><p class=\"description\">Votre billet est prêt ! Nous avons hâte de vous accueillir à notre événement. Veuillez trouver votre billet personnalisé joint à cet email en PDF.</p></div><div class=\"divider\"></div><div class=\"info-box\"><div class=\"info-row\"><span class=\"info-icon\">🎭</span><span class=\"info-label\">Event / Événement:</span><span class=\"info-value\">{event_name}</span></div><div class=\"info-row\"><span class=\"info-icon\">📅</span><span class=\"info-label\">Date:</span><span class=\"info-value\">{event_date}</span></div><div class=\"info-row\"><span class=\"info-icon\">📍</span><span class=\"info-label\">Location / Lieu:</span><span class=\"info-value\">{event_location}</span></div><div class=\"info-row\"><span class=\"info-icon\">👤</span><span class=\"info-label\">Guest / Invité:</span><span class=\"info-value\">{name}</span></div></div><div class=\"token-box\"><div class=\"token-label\">🔑 Quick Access Code / Code d'accès rapide</div><div class=\"token-value\">{token_short}</div></div><div class=\"important-box\"><div class=\"important-title\">⚠️ Important Instructions / Instructions importantes</div><div class=\"important-text\"><strong>English:</strong> Present your QR code at the entrance. Each ticket is valid for a single entry only. Please bring a valid ID.<br><br><strong>Français:</strong> Présentez votre code QR à l'entrée. Chaque billet est valable pour une seule entrée uniquement. Veuillez apporter une pièce d'identité valide.</div></div><p class=\"description\" style=\"margin-top:25px;text-align:center;color:#718096\"><strong>Need help? / Besoin d'aide ?</strong><br>Reply to this email or contact our support team.<br>Répondez à cet email ou contactez notre équipe de support.</p></div><div class=\"footer\"><div class=\"footer-logo\">✨ {organizer}</div><p class=\"footer-text\">Thank you for choosing our event!<br>Merci d'avoir choisi notre événement !<br><br>Secure Ticket Management System<br>Système de gestion de tickets sécurisé</p><p class=\"footer-note\">This ticket is cryptographically signed and linked to a single entry.<br>Ce billet est cryptographiquement signé et lié à une seule entrée.<br><br>This email was sent automatically, please do not reply directly.<br>Cet email a été envoyé automatiquement, merci de ne pas répondre directement.</p></div></div></body></html>",
    "smtp_server": "smtp.gmail.com",
    "smtp_port": 465,
    "from_email": ""
  },
  "pdf": {
    "title": "{event_name}",
    "subtitle": "{event_date} - {event_location}",
    "footer": "Bring a valid ID. One entry per ticket."
  }
}
